<tr id="<%= dom_id(charge) %>">
  <td><code><%= charge.txid.first(10) %>…</code></td>
  <td><%= number_to_currency(charge.amount_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %></td>
  <td><span class="badge <%= charge.status %>"><%= charge.status %></span></td>
  <td>
    <% charge.webhook_events.each do |event| %>
      <span class="badge <%= event.status %>" title="<%= event.last_error %>"><%= event.event_type %> · <%= event.status %> (<%= event.attempts %>)</span>
    <% end %>
  </td>
  <td><%= l(charge.created_at, format: :short) %></td>
  <td>
    <% if charge.pending? %>
      <%= button_to "Simular pagamento", pay_charge_path(charge), method: :post, class: "btn" %>
    <% end %>
  </td>
</tr>
