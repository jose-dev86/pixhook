<% content_for :title, t(".title") %>
<% content_for :subtitle, t(".subtitle") %>
<%= turbo_stream_from "charges" %>

<nav class="tabs" aria-label="Filtrar por status">
  <%= link_to charges_path, class: [ "tab", { "tab--active" => @status.nil? } ] do %>
    <%= t(".all") %> <span class="tab__count"><%= @counts.values.sum %></span>
  <% end %>
  <% Charge.statuses.each_key do |status| %>
    <%= link_to charges_path(status:), class: [ "tab", { "tab--active" => @status == status } ] do %>
      <%= Charge.human_attribute_name("statuses.#{status}") %> <span class="tab__count"><%= @counts.fetch(status, 0) %></span>
    <% end %>
  <% end %>
</nav>

<section class="card card--flush">
  <%= render "charges/table", charges: @charges %>
</section>
